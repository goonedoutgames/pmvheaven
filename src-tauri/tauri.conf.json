{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PMVHeaven",
  "version": "0.1.0",
  "identifier": "com.pmvheaven.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm desktop:prepare",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "PMVHeaven",
        "url": "http://localhost:3000",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["server/**/*"],
    "category": "Entertainment",
    "shortDescription": "Ad-free PMVHaven client",
    "longDescription": "A sleek, ad-free desktop client for PMVHaven with a permanent watch-history archive and a play queue."
  }
}
